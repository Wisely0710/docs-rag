# ── 機密／環境（絕不入庫）
.env
.env.*

# ── 虛擬環境與快取
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 部署期產物（語料／索引／日誌不屬版控；一個 corpus 一個 data-<corpus>）
corpus/
data/
data-*/
logs/

# ── 前 git 時期的手工備份（已由 git 歷史取代）
*.bak-*

# Deployment data: the real corpus config is not tracked (see corpora.example.json)
corpora.json

# Evaluation work dir (corpus checkout + index; see eval/README.md)
eval/.work/

# ... except the eval fixture: committed test corpus + its config (see eval/README.md).
# These negations must come last — the last matching pattern wins, so they have to
# follow the corpus/ and corpora.json rules above.
!eval/fixture/corpus/
!eval/fixture/corpora.json

# QA evaluation work dir (portfolio corpus checkout + index; see eval/qa/README.md)
eval/qa/.work/

# ... except the QA fixture, on the same terms as the retrieval fixture above.
!eval/qa/fixture/corpus/
!eval/qa/fixture/corpora.json
